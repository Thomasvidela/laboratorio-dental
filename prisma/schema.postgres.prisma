generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  labName      String   @default("Laboratorio Dental")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  category    String        @default("General")
  description String        @default("")
  price       Float
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  entries     LedgerEntry[]

  @@index([category])
  @@index([name])
}

model Dentist {
  id         String        @id @default(cuid())
  fullName   String
  clinicName String        @default("")
  phone      String        @default("")
  email      String        @default("")
  address    String        @default("")
  notes      String        @default("")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  entries    LedgerEntry[]

  @@index([fullName])
}

model LedgerEntry {
  id             String   @id @default(cuid())
  dentistId      String
  dentist        Dentist  @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  type           String   // "CHARGE" (Trabajo/Producto cargado) | "PAYMENT" (Pago registrado)
  concept        String   // Nombre del producto o concepto del pago
  patientOrNotes String   @default("")
  quantity       Int      @default(1)
  unitPrice      Float    @default(0)
  amount         Float
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dentistId, occurredAt])
  @@index([type])
}

model BackupSnapshot {
  id            String   @id @default(cuid())
  reason        String   @default("Respaldo Automático")
  productsCount Int      @default(0)
  dentistsCount Int      @default(0)
  entriesCount  Int      @default(0)
  payloadJson   String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
